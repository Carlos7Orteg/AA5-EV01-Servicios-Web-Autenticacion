<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración Maven del servicio independiente de autenticación AA5-EV01. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Versión del modelo de configuración de Maven. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Hereda versiones administradas por Spring Boot del proyecto AA3 de referencia. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- Identificación del proyecto según la guía AA5-EV01. -->
    <groupId>co.edu.sena</groupId>
    <artifactId>auth</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>AA5-EV01 Servicios Web Autenticacion</name>
    <description>Servicio web independiente para registro e inicio de sesión.</description>

    <!-- Mantiene Java 21 del proyecto base; la guía exige Java 17 o superior. -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Dependencias necesarias para API REST, persistencia, validación y BCrypt. -->
    <dependencies>
        <!-- Permite crear los endpoints REST del servicio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Proporciona persistencia JPA para los usuarios registrados. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Permite validar los datos recibidos en los DTO. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Proporciona BCrypt sin activar la seguridad completa de Spring Security. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Controlador JDBC de MySQL, requerido en tiempo de ejecución. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Dependencias de prueba para persistencia JPA. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Dependencias de prueba para los controladores web MVC. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Plugin para ejecutar y empaquetar la aplicación Spring Boot. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>